generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db?connection_limit=1&socket_timeout=30"
}

model User {
  id           String   @id
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  knowledgeBases Knowledge[]
  resumes        Resume[]
}

model Knowledge {
  id          String   @id
  userId      String
  name        String
  description String   @default("")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents     Document[]
  conversations Conversation[]
  questions     Question[]

  @@index([userId])
}

model Document {
  id          String   @id
  knowledgeId String
  filename    String
  filepath    String   @default("")
  mimeType    String   @default("application/octet-stream")
  size        Int      @default(0)
  parseStatus String   @default("pending")
  chunkCount  Int      @default(0)
  charCount   Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  knowledge Knowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  chunks    Chunk[]
}

model Chunk {
  id         String   @id
  documentId String
  chunkIndex Int
  content    String
  tokenCount Int      @default(0)
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Conversation {
  id           String    @id
  knowledgeId  String
  title        String    @default("新对话")
  messageCount Int       @default(0)
  /// 超出滑动窗口的早期对话摘要（懒生成并缓存，避免每次请求重复总结）
  summary      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  knowledge Knowledge @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id             String   @id
  conversationId String
  role           String   // 'user' | 'assistant' | 'system'
  content        String
  citations      String   @default("[]")  // JSON array of citations
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

/// 面试题目卡：结构化题库单元（题目 + 参考答案 + 类目/难度/关键词）
model Question {
  id          String   @id
  knowledgeId String
  category    String   @default("未分类")
  /// easy | medium | hard
  difficulty  String   @default("medium")
  question    String
  answer      String
  /// JSON 数组字符串，如 ["闭包","作用域"]
  keywords    String   @default("[]")
  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  knowledge       Knowledge        @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  practiceRecords PracticeRecord[]

  @@index([knowledgeId, category])
  @@index([knowledgeId, difficulty])
}

/// 答题记录：模拟面试 / 刷题模式的评估结果，用于掌握度统计
model PracticeRecord {
  id          String   @id
  questionId  String
  userId      String
  /// question | mock
  mode        String   @default("question")
  userAnswer  String
  /// 0-100
  score       Int      @default(0)
  feedback    String   @default("")
  evaluatedAt DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
}

/// 简历分析记录：上传简历 → 解析内容 → AI 分析报告
model Resume {
  id           String   @id
  userId       String
  filename     String
  fileSize     Int      @default(0)
  /// 原始解析文本（截取前 8000 字符送 LLM）
  content      String
  /// AI 分析报告（Markdown）
  analysis     String
  /// 0-100 整体评分
  score        Int      @default(0)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
