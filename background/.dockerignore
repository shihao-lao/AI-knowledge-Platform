.env.local
.env.*.local

# 编辑器与版本控制
.idea/
.vscode/
.git/
.gitignore
.gitattributes

# 测试与文档（运行镜像不需要）
tests/
docs/
Dockerfile
docker-compose.yml
.dockerignore
