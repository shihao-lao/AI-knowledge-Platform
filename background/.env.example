# 应用
APP_NAME=enterprise-ai-agent
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# 认证（必需）
# 生成密钥: python -c "import secrets; print(secrets.token_hex(32))"
# 未配置、少于 32 字节或仍是示例值时，服务会拒绝启动。
SECRET_KEY=please-change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS 配置
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# 速率限制
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
# 仅信任实际反向代理的 IP/CIDR；Uvicorn 验证后将地址交给限流中间件。
# 直连部署可留空，不要使用 *，也不要把普通客户端网段加入名单。
FORWARDED_ALLOW_IPS=

# 以下模型配置是「服务端默认」，仅作为兜底：
# 用户在「设置 → 模型配置」页填写自己的 Base URL / API Key / 模型后，
# 该用户的全部 AI 调用（问答、评分、简历分析、摘要）都会优先使用他自己的配置。
# 因此这里留空也不会让功能不可用，只是没有配置的用户无法使用 AI。

# OpenAI / 兼容 API
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# MiMo（配置了 MIMO_API_KEY 时优先于上面的 OpenAI 配置）
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5

# 默认请求参数（用户未单独设置时生效）
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# 回环地址默认绕过系统代理（127.0.0.1/localhost/::1 会自动追加到 NO_PROXY），
# 否则本地 Ollama 等模型服务会被系统代理转发并返回 502。

# RAG 嵌入模型（首次使用需要下载，切换模型会使用独立向量集合）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 模型下载源。国内网络通常无法直连 huggingface.co，不配镜像会导致模型加载失败。
# 官方源：https://huggingface.co    镜像：https://hf-mirror.com
HF_ENDPOINT=https://hf-mirror.com

# MySQL（应用运行时用 aiomysql；Alembic 迁移会自动改用同步的 pymysql）
# 建库语句：
#   CREATE DATABASE ai_knowledge_platform CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/ai_knowledge_platform

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION_NAME=agent_knowledge

# 检索精排（Cross-Encoder）：双路召回后重排，任何失败都会自动退回 RRF 顺序
# RERANK_ENABLED=1
# RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# 中文精度优先可换 BAAI/bge-reranker-base（约 2.4 倍体积与 CPU 耗时）
# RERANK_DEVICE=cpu

# 日志
LOG_LEVEL=INFO
