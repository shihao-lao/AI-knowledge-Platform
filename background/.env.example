# 应用
APP_NAME=enterprise-ai-agent
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# 认证（必需）
# 生成密钥: python -c "import secrets; print(secrets.token_hex(32))"
# 未配置、少于 32 字节或仍是示例值时，服务会拒绝启动。
SECRET_KEY=please-change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS 配置
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# 速率限制
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# OpenAI / 兼容 API
OPENAI_API_KEY=sk-your-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# MiMo（聊天使用；答案评分优先使用 MiMo，未配置时使用上面的 OpenAI 配置）
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5

# RAG 嵌入模型（首次使用需要下载，切换模型会使用独立向量集合）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION_NAME=agent_knowledge

# 日志
LOG_LEVEL=INFO
