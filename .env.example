# ==================== Embedding Provider ====================
# bge  ：本地 BGE 中文模型（bge-small-zh-v1.5，512 维），语义检索，推荐
# local：字符哈希 embedding（离线可用，无语义，仅开发降级）
# 切换 provider 后需重跑: npx tsx scripts/reingest-vectors.ts
EMBEDDING_PROVIDER=bge

# 可选：模型下载源（国内网络可设 https://hf-mirror.com；或让 Node 走本地代理，
# 如设置 HTTPS_PROXY=http://127.0.0.1:7892 与 NODE_USE_ENV_PROXY=1）
# HF_ENDPOINT=https://hf-mirror.com

# ==================== 小米 MiMo 大模型（服务端专用） ====================
# 仅服务端 Route Handler / Server Component 读取。
# 切勿使用 NEXT_PUBLIC_ 前缀，否则密钥会被打进浏览器 bundle 泄露。
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_API_KEY=your_mimo_api_key
MIMO_MODEL=mimo-v2.5

# 开发/测试：设为 1 时使用确定性模拟回答（不调用外部 API），便于验证 RAG 管线与离线开发
LLM_MOCK=0

# ==================== 会话安全 ====================
# 用于签发登录会话 cookie 的签名密钥，请替换为任意长随机字符串（>= 32 字符）
# 可用命令生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=please-change-me-to-a-long-random-string

# ==================== Next.js 配置 ====================
NEXT_PUBLIC_API_URL=http://localhost:3000
